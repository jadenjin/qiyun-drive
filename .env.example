PUBLIC_BASE_URL=http://localhost
SITE_ADDRESS=http://localhost
S3_PUBLIC_ENDPOINT=http://localhost
COOKIE_SECURE=false
TRUST_PROXY=false
RUSTFS_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_ADDRESS=127.0.0.1
