FROM golang:1.26.6-alpine AS build
ARG CADDY_VERSION=v2.11.4
ARG CADDY_COMMIT=e2eee6a7fce366321294c9c2a79f3146891dcbdf
ARG CADDY_CEL_V2_COMMIT=b2693fb63a30e6d7be0972c3645e9a2c0a500e93
WORKDIR /src
ENV GOMAXPROCS=1 GOFLAGS=-p=1
RUN apk add --no-cache git \
 && git clone --branch "${CADDY_VERSION}" --depth 1 https://github.com/caddyserver/caddy.git . \
 && test "$(git rev-parse HEAD)" = "${CADDY_COMMIT}" \
 && git fetch --depth 2 origin "${CADDY_CEL_V2_COMMIT}" \
 && test "$(git rev-parse FETCH_HEAD)" = "${CADDY_CEL_V2_COMMIT}" \
 && git cherry-pick --no-commit "${CADDY_CEL_V2_COMMIT}" \
 && go get github.com/go-chi/chi/v5@v5.3.0 github.com/google/cel-go@v0.30.0 github.com/klauspost/compress@v1.18.7 golang.org/x/crypto@v0.56.0 golang.org/x/net@v0.58.0 golang.org/x/text@v0.41.0 google.golang.org/grpc@v1.83.1 \
 && go mod tidy \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/caddy ./cmd/caddy

FROM alpine:3.23
RUN apk upgrade --no-cache \
 && apk add --no-cache ca-certificates mailcap tzdata \
 && adduser -D -u 10002 caddy \
 && mkdir -p /config/caddy /data/caddy /srv \
 && chown -R caddy:caddy /config /data /srv
ENV XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data
COPY --from=build /out/caddy /usr/bin/caddy
EXPOSE 80 443 443/udp 2019
USER caddy
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
